# For running the API outside Docker (go run . serve). In Docker, docker-compose.yml sets all of this.
SERVE_PORT=8080
# The SQLite database file; created on first start. Run the worker with the same path.
DATABASE_PATH=budget.db
LOG_LEVEL=DEBUG
# Browsers on these origins may call the API (see the README).
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Queue uncategorized expenses for the worker (go run . worker, which needs Ollama at LLM_URL).
# CATEGORIZATION_ENABLED=true
# LLM_URL=http://localhost:11434
# Optional: comma-separated bridge hosts setup tokens may be claimed from
# (default: bridge.simplefin.org,beta-bridge.simplefin.org)
# SIMPLEFIN_CLAIM_HOSTS=
