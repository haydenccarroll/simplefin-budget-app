# Copy to .env and adjust. Everything has a default, so an empty .env works too.

# Where the API listens on this machine.
API_PORT=8080

# Web origins allowed to call the API from a browser, comma separated. the Vite
# dev server is http://localhost:8081.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# The model that categorizes transactions (pulled on first start).
LLM_MODEL=qwen2.5:3b
LOG_LEVEL=INFO
